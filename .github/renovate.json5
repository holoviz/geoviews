{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":enablePreCommit"],
  enabledManagers: ["github-actions", "pre-commit", "pixi", "npm"],
  lockFileMaintenance: {
    enabled: true,
  },
  schedule: ["before 5am on the 1st day of the month"],

  automerge: true,
  commitMessagePrefix: "chore(bot):",
  prConcurrentLimit: 0,
  prCreation: "immediate",
  prHourlyLimit: 0,

  internalChecksFilter: "strict",
  minimumReleaseAge: "7 days",
  separateMajorMinor: false,

  packageRules: [
    {
      groupName: "GitHub Actions",
      matchManagers: ["github-actions"],
      pinDigests: true,
    },
    {
      groupName: "HoloViz Github Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["holoviz-dev/holoviz_tasks"],
      minimumReleaseAge: null,
      schedule: ["before 5am"],
      pinDigests: true,
    },
    {
      groupName: "pre-commit",
      matchManagers: ["pre-commit"],
    },
    {
      matchManagers: ["pixi"],
      enabled: false, // We don't want updates pixi.toml
    },
    {
      groupName: "Pixi Lock",
      matchManagers: ["pixi"],
      matchUpdateTypes: ["lockFileMaintenance"],
      description: "Weekly update of Pixi Lock",
      schedule: ["before 5am on monday"],
      automergeSchedule: ["after 5am on monday"], // avoid multiple PRs in the same day
      prConcurrentLimit: 1, // avoid multiple PRs in the same day
      minimumReleaseAge: null, // Handled in pixi itself
      commitMessageAction: "Update",
      commitMessageTopic: "pixi.lock",
      branchTopic: "pixi-lock",
      enabled: true,
    },
    {
      matchManagers: ["npm"],
      enabled: false, // We don't want updates package.json
    },
    {
      groupName: "NPM Lock",
      matchManagers: ["npm"],
      matchUpdateTypes: ["lockFileMaintenance"],
      description: "Monthly update of NPM Lock",
      schedule: ["before 5am on the 1st day of the month"],
      automergeSchedule: ["after 5am on the 1st day of the month"], // avoid multiple PRs in the same day
      prConcurrentLimit: 1, // avoid multiple PRs in the same day
      commitMessageAction: "Update",
      commitMessageTopic: "package-lock.json",
      branchTopic: "npm-lock",
      enabled: true,
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
    minimumReleaseAge: null,
    vulnerabilityFixStrategy: "lowest",
  },
}
